    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Javascript Date() methods are garbage, use String instead\nvar dateparts = $('When Executed by Another Workflow').first().json.start.split(\"T\")[0].split(\"-\");\nvar date = dateparts[2] + \"/\" + dateparts[1] + \"/\" + dateparts[0];\n\n// On fait un -1 pour enlever le compte de service du nombre total d'utilisateur.\nreturn {\n  \"data\":[\n    {\n      \"Type\": \"Users\",\n      \"Date\": date,\n      \"Project\": $('Get row(s)').item.json.odigo_projectid,\n      \"SubEntity\": $('Get row(s)').item.json.odigo_subentityid,\n      \"Quantity\": $('Cloud GET enterprise users').item.json.users.length - 1\n    },{\n      \"Type\": \"Tickets\",\n      \"Date\": date,\n      \"Project\": $('Get row(s)').item.json.odigo_projectid,\n      \"SubEntity\": $('Get row(s)').item.json.odigo_subentityid,\n      \"Quantity\": $('Cloud GET enterprise ticket report').item.json.metrics.nb_ticket\n    }\n  ]\n}"
      },
