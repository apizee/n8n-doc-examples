    {
      "parameters": {
        "jsCode": "// Date calculations assume this workflow was scheduled the first day of the month after midnight\nvar invocation = new Date($input.first().json.timestamp);\n\n// Get the first day of the previous month\nvar start = new Date(invocation.getFullYear(), invocation.getMonth()-1, 1).toISOString().split(\".\")[0] + \"Z\";\n\n// Get the last day of the previous month\nvar end = new Date(invocation.getFullYear(), invocation.getMonth(), 0).toISOString().split(\".\")[0] + \"Z\";\n\n// Build the filename with the last day of the previous month\nvar filename = \"Apizee\" + new Date(invocation.getFullYear(), invocation.getMonth(), 0).toISOString().split(\"T\")[0].replaceAll(\"-\",\"\") + \".csv\";\n\nreturn {\"start\": start, \"end\": end, \"filename\": filename};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
