    {
      "parameters": {
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"systemInstruction\": {\n    \"role\": \"user\",\n    \"parts\": [\n      {\n        \"text\": \"\\nYou are a a network engineer expert. Your role is to provide support to users.\\nA user called for issues with their network connectivity. You are asked to troubleshoot the issue.\\n\\nYou have to visually analyze photos and videos on their Internet router provided in input. You need to search for 2 types of informations:\\n- The sticker listing the identification of the router.\\n- The front panel of the router showing the status LEDs.\\n\\nFirst detect whether the media is showing the serial number or the front panel, or both, then analyze it accordingly. If the media shows something else, just state that you are not able to analyze it.\\n\\nWhen the media shows a serial number: You will output \\\"Device identification\\\", then the SN, MAC and IMEI, one per line prefixed by a dash.\\n\\nWhen the media is the front panel of the router: You will output \\\"Front panel LEDs\\\", the the color and status of each LED (ON, OFF, BLINKING), one per line prefixed by a dash.\\nOn the considered router, the LEDs and buttons are layed out as follows on the front panel(from bottom to top):\\n1. Round LED : Power\\n2. Round LED : Fiber\\n3. Round LED : Internet\\n4. Button : WPS\\n5. Bar LED : WiFi\\n6. Button : WiFi\\n7. Round LED : Phone\\n\\nWrite your answers under key: value form. For LED detection, output one line per LED. For Serial Number detection, output one line per identifier. Don't use markdown formatting\"\n      }\n    ]\n  },\n  \"contents\": {\n    \"role\": \"user\",\n    \"parts\": [\n      {\n        \"fileData\": {\n          \"mimeType\": {{ \"\\\"\" + $json.contentType + \"\\\"\" }},\n          \"fileUri\": {{ \"\\\"\" + \"gs://\" + $('Google Cloud Storage - Store image').item.json.bucket + \"/\" + $('Google Cloud Storage - Store image').item.json.name + \"\\\"\" }}\n        }\n      },\n      {\n        \"text\":\"Analyze this image. Write your answer in french.\"\n      }\n    ]\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        656,
        448
      ],
